# Copy to .env at the project root. Never commit .env.
# Supabase: use the session pooler PostgreSQL URI, not the project HTTP URL.
DATABASE_URL=
# Use a separate existing schema for pilot/showcase data. Bootstrap creates one safely.
APP_DATABASE_SCHEMA=public
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_PASSWORD=
# Frontend API_BASE_URL is configured in frontend/.env.local if needed.
SECURE_COOKIES=false
BM_DEBUG=false
# Optional: development PostgreSQL URL; tests create/drop only random test schemas.
TEST_DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
